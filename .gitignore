# saidas de build
build/
bin/
obj/
target/
dist/*.jar
*.class
__pycache__/
*.pyc

# artefatos de execucao
log/
logs/
*.log

# IDE
.idea/
.vs/
*.iml
.classpath
.project
.settings/

# overrides locais com segredos -- database.properties fica como template
myls.properties

# derivado da captura
replay.bin

# arquivos de trabalho do SQLite: mudam a cada execucao do servidor
*.db-shm
*.db-wal

# pacote gerado por pacote/empacotar.ps1
dist/

# banco de dados: estado de execucao (contas, personagens, tokens de sessao). Se regenera sozinho
# na primeira vez que o servidor sobe, e mudava a cada teste.
*.db

# base Java de referencia (Aion-Lightning): 359 MB de codigo de terceiros que nao executa aqui.
# O LEIA-ME-FONTE.txt explica onde encontra-la.
reference/

# copia da instalacao do cliente. Sao dezenas de GB, e o motivo dela existir e justamente nao
# depender do launcher: quando a Gameforge atualizar para 5.0, os arquivos de nivel e os .pak de
# 4.5 so existem aqui. Nao entra no git.
Cliente/
