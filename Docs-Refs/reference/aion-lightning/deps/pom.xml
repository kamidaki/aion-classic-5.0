<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dependencias que o Aion-Lightning assume existirem no JDK, mas que foram removidas no Java 11.

  Elas nao aparecem como erro de compilacao porque compilamos com "release 8", que expoe a API do
  Java 8 inteira, incluindo o que o JDK moderno nao carrega mais. O tombo so acontece em runtime,
  como NoClassDefFoundError. Por isso ficam vendorizadas em server/libs-modern, separadas dos jars
  originais do AL, deixando claro o que foi acrescentado e por que.

  Regerar com: bash scripts/fetch_deps.sh
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aionemu</groupId>
    <artifactId>aion-classic-deps</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <dependencies>
        <!--
          JAXB. A serie 2.3.x e a ultima no namespace javax.xml.bind. Da 3.0 em diante o pacote
          virou jakarta.xml.bind, o que exigiria reescrever os imports de 745 arquivos do AL-Game.

          So o runtime e declarado, de proposito: ele ja arrasta a api transitivamente. Declarar
          tambem javax.xml.bind:jaxb-api traria um segundo jar definindo as mesmas classes
          javax.xml.bind, e qual das duas copias ganha passa a depender da ordem do classpath.
        -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.9</version>
        </dependency>
    </dependencies>
</project>
