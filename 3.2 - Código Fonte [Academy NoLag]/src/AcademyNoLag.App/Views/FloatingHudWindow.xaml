<Window x:Class="AcademyNoLag.App.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AcademyNoLag.App.Controls"
        xmlns:vm="clr-namespace:AcademyNoLag.App.ViewModels"
        mc:Ignorable="d"
        Title="Academy NoLag — Gaming HUD"
        Width="465" Height="545"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- Outer Glow Container -->
    <Border Margin="10" CornerRadius="14" Background="#0B0F19" BorderBrush="#00E5FF" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00E5FF" Opacity="0.38"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/> <!-- Compact Vertical Navbar -->
                <ColumnDefinition Width="*"/>  <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================== -->
            <!-- 1. COMPACT VERTICAL NAVBAR (Sidebar com Ícones)                 -->
            <!-- ============================================================== -->
            <Border Grid.Column="0" Background="#080C14" CornerRadius="12,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/> <!-- App Icon / Brand -->
                        <RowDefinition Height="*"/>  <!-- Navigation Icon Buttons -->
                        <RowDefinition Height="40"/> <!-- Status Dot Indicator -->
                    </Grid.RowDefinitions>

                    <!-- Top Brand Icon -->
                    <Border Grid.Row="0" Width="30" Height="30" Background="#00E5FF" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0B0F19"/>
                    </Border>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                        <!-- 0: Dashboard -->
                        <Button Tag="0" Click="NavButton_Click" ToolTip="Dashboard &amp; Telemetria (Gráfico em Tempo Real)"
                                Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#151E32"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 1: Rotas (Candidate routes & latency test) -->
                        <Button Tag="1" Click="NavButton_Click" ToolTip="Rotas de Peering &amp; Servidores (Teste Manual)"
                                Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#151E32"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 2: Jogos (ExitLag style per-game toggle) -->
                        <Button Tag="2" Click="NavButton_Click" ToolTip="Gerenciador de Jogos (Marcar/Desmarcar Otimização)"
                                Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#151E32"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 3: Ajustes (Kernel TCP tweaks, Flush DNS) -->
                        <Button Tag="3" Click="NavButton_Click" ToolTip="Ajustes de Kernel TCP &amp; Limpeza DNS"
                                Width="38" Height="38" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#151E32"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Status Indicator Dot -->
                    <Ellipse Grid.Row="2" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveGame}" Value="False">
                                        <Setter Property="Fill" Value="#64748B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. MAIN CONTENT AREA                                           -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Draggable Header -->
                    <RowDefinition Height="*"/>  <!-- Dynamic Tab Content Views -->
                    <RowDefinition Height="46"/> <!-- Bottom Actions & Status -->
                </Grid.RowDefinitions>

                <!-- HEADER (Draggable) -->
                <Border Grid.Row="0" Background="#111827" CornerRadius="0,12,0,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ACADEMY " FontWeight="Black" FontSize="13" Foreground="#F8FAFC"/>
                            <TextBlock Text="NOLAG" FontWeight="Black" FontSize="13" Foreground="#00E5FF"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="HUD" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>

                        <!-- Window Controls (Pin & Close to Tray) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Width="26" Height="26" Margin="0,0,4,0" 
                                    ToolTip="Fixar sobre a tela" Click="PinButton_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="📌" FontSize="12" Foreground="#94A3B8"/>
                            </Button>
                            <Button Width="26" Height="26" 
                                    ToolTip="Minimizar para a bandeja" Click="CloseButton_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="12" Foreground="#EF4444" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTENT VIEWS TAB CONTROL -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ============================================================== -->
                    <!-- TAB 0: DASHBOARD (Dual Ping + Telemetry Graph + Detailed Stats) -->
                    <!-- ============================================================== -->
                    <TabItem>
                        <Grid Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Active Game Banner -->
                                <RowDefinition Height="Auto"/> <!-- Dual Ping Cards -->
                                <RowDefinition Height="130"/>  <!-- Real-Time Telemetry Graph -->
                                <RowDefinition Height="Auto"/> <!-- Detailed Telemetry Grid -->
                            </Grid.RowDefinitions>

                            <!-- Active Game Banner -->
                            <Border Grid.Row="0" Background="#111827" CornerRadius="8" Padding="10,6" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActiveGame}" Value="False">
                                                                <Setter Property="Fill" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ActiveGameName}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PrimaryEndpointDisplay}" FontSize="10" Foreground="#94A3B8" Margin="13,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="5" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveGamePid}" FontSize="9" FontWeight="SemiBold" Foreground="#00E5FF"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Dual Ping Comparison Hero Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Baseline Direct Ping -->
                                <Border Grid.Column="0" Background="#131B2E" CornerRadius="8" Padding="8,6" BorderBrush="#1E293B" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ISP PADRÃO" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DirectPing, StringFormat={}{0:F0}}" FontSize="22" FontWeight="Black" Foreground="#94A3B8"/>
                                            <TextBlock Text=" ms" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                        <TextBlock Text="Sem Otimização" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Optimized Ping (Neon Glow) -->
                                <Border Grid.Column="2" Background="#0C2338" CornerRadius="8" Padding="8,6" BorderBrush="#00E5FF" BorderThickness="1.2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00E5FF" Opacity="0.3"/>
                                    </Border.Effect>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="OTIMIZADO" FontSize="8" FontWeight="Black" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding OptimizedPing, StringFormat={}{0:F0}}" FontSize="22" FontWeight="Black" Foreground="#00E5FF"/>
                                            <TextBlock Text=" ms" FontSize="10" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                        <!-- Improvement pill -->
                                        <Border Background="#10B981" CornerRadius="3" Padding="5,1" Margin="0,1,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ImprovementDisplay}" FontSize="8" FontWeight="Bold" Foreground="#0B0F19"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Real-Time Telemetry Graph (+150px Space) -->
                            <Border Grid.Row="2" Background="#0C1220" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,6" ClipToBounds="True">
                                <controls:RealTimeMetricGraph DirectPoints="{Binding DirectGraphPoints}" OptimizedPoints="{Binding OptimizedGraphPoints}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>

                            <!-- Detailed Telemetry Grid -->
                            <Border Grid.Row="3" Background="#111827" CornerRadius="8" Padding="10,6" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Jitter -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="JITTER" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F8FAFC">
                                            <Run Text="{Binding OptimizedJitter, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=" ms" FontSize="8" Foreground="#64748B"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Packet Loss -->
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="PERDA" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#10B981">
                                            <Run Text="{Binding OptimizedLoss, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="%" FontSize="8"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Quality Grade -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="QUALIDADE" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#00E5FF">
                                            <Run Text="{Binding RouteQualityScore, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text="/100 [" FontSize="8" Foreground="#64748B"/><Run Text="{Binding RouteGrade, Mode=OneWay}" FontSize="8" Foreground="#10B981"/><Run Text="]" FontSize="8" Foreground="#64748B"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Active Route Node -->
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                        <TextBlock Text="ROTA ATIVA: " FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedNodeName}" FontSize="8" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,4,0"/>
                                        <TextBlock Text="(" FontSize="8" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedNodeRegion}" FontSize="8" Foreground="#94A3B8"/>
                                        <TextBlock Text=")" FontSize="8" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ============================================================== -->
                    <!-- TAB 1: ROTAS (Lista de Rotas Disponíveis & Teste Manual)        -->
                    <!-- ============================================================== -->
                    <TabItem>
                        <Grid Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header + Refresh -->
                                <RowDefinition Height="*"/>    <!-- Routes List -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ROTAS DE REDE &amp; PEERING" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Clique para testar e aplicar a rota instantaneamente:" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="↻ Testar Pings" Command="{Binding RefreshNodesCommand}"
                                        Background="#1E293B" Foreground="#00E5FF" FontSize="9" FontWeight="Bold"
                                        Padding="8,4" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Candidate Relay Nodes List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-4,0">
                                <ItemsControl ItemsSource="{Binding RelayNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="8" Padding="10,8" Margin="0,0,4,6" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Region Flag / Icon -->
                                                    <Border Grid.Column="0" Width="26" Height="26" Background="#151E32" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="🌐" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Node Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9" Foreground="#64748B">
                                                            <Run Text="{Binding Region}"/><Run Text=" • "/><Run Text="{Binding Host}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Ping Badge -->
                                                    <Border Grid.Column="2" Background="#102E24" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding LatencyDisplay}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                                    </Border>

                                                    <!-- Apply Route Button -->
                                                    <Button Grid.Column="3" Content="Aplicar" 
                                                            Command="{Binding DataContext.SelectManualRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#00B4D8" Foreground="#0B0F19" FontWeight="Bold" FontSize="9"
                                                            Padding="10,4" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ============================================================== -->
                    <!-- TAB 2: JOGOS (Gerenciador de Jogos - Estilo ExitLag)            -->
                    <!-- ============================================================== -->
                    <TabItem>
                        <Grid Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="*"/>    <!-- Games List -->
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="GERENCIADOR DE JOGOS (EXITLAG STYLE)" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                <TextBlock Text="Marque ou desmarque para ativar a otimização de cada jogo:" FontSize="9" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Game Profiles List with Individual Toggles -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-4,0">
                                <ItemsControl ItemsSource="{Binding GameProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="8" Padding="10,8" Margin="0,0,4,6" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Game Icon -->
                                                    <Border Grid.Column="0" Width="26" Height="26" Background="#151E32" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="🎮" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Title & Category -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                                        <TextBlock FontSize="9" Foreground="#64748B">
                                                            <Run Text="{Binding Category}"/><Run Text=" • "/><Run Text="{Binding ProcessNames[0]}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Auto Optimize Toggle Switch for this Game -->
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding AutoOptimize, Mode=TwoWay}"
                                                              Command="{Binding DataContext.ToggleProfileAutoOptimizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"
                                                              VerticalAlignment="Center" Cursor="Hand">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Border Width="32" Height="18" CornerRadius="9">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#334155"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Ellipse Width="14" Height="14" Fill="#F8FAFC" Margin="2,0">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ============================================================== -->
                    <!-- TAB 3: AJUSTES (Kernel TCP Tweaks, MMCSS, DNS Flush)           -->
                    <!-- ============================================================== -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,8,6,0">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="AJUSTES DE KERNEL &amp; REDE" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" Margin="0,0,0,6"/>

                                <!-- Tweak Card 1: TCP NoDelay -->
                                <Border Background="#111827" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TCP NoDelay &amp; Zero Delayed ACK" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                            <TextBlock Text="TcpAckFrequency=1 • TCPDelAckTicks=0 (Sem buffer de 200ms)" FontSize="9" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#102E24" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="ATIVO ✓" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Tweak Card 2: MMCSS Game Scheduling -->
                                <Border Background="#111827" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MMCSS &amp; SystemResponsiveness" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                            <TextBlock Text="NetworkThrottlingIndex=0xFFFFFFFF (100% banda p/ pacotes)" FontSize="9" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#102E24" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="ATIVO ✓" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Tweak Card 3: QoS DSCP 46 -->
                                <Border Background="#111827" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="QoS DSCP 46 (Expedited Forwarding)" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC"/>
                                            <TextBlock Text="Priorização VIP de pacotes no roteador e placas de rede" FontSize="9" Foreground="#64748B"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#102E24" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="ATIVO ✓" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Action Buttons -->
                                <Button Content="Limpar Cache DNS &amp; ARP Resolver" Command="{Binding FlushDnsCommand}"
                                        Background="#1E293B" Foreground="#00E5FF" FontWeight="Bold" FontSize="10"
                                        Padding="12,7" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" Margin="0,4,0,6">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Content="Simular Detecção Aion Classic 5.0 (Teste)" Command="{Binding SimulateAionLaunchCommand}"
                                        Background="#151E32" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="9"
                                        Padding="10,5" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- BOTTOM ACTIONS -->
                <Border Grid.Row="2" Background="#111827" CornerRadius="0,0,12,0" Padding="12,8" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Auto Optimize Toggle -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding AutoOptimize}" VerticalAlignment="Center" Cursor="Hand">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="18" CornerRadius="9" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Ellipse Width="14" Height="14" Fill="#F8FAFC" Margin="2,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Border>
                                        <TextBlock Text="Otimização Automática" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Status Badge -->
                        <Border Grid.Column="1" Background="#102E24" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
