<Window x:Class="AcademyNoLag.App.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AcademyNoLag.App.Controls"
        xmlns:vm="clr-namespace:AcademyNoLag.App.ViewModels"
        mc:Ignorable="d"
        Title="Academy NoLag — Gaming HUD"
        Width="465" Height="695"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- Outer Glow Container -->
    <Border Margin="10" CornerRadius="14" Background="#0B0F19" BorderBrush="#00E5FF" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00E5FF" Opacity="0.38"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/> <!-- Compact Vertical Navbar -->
                <ColumnDefinition Width="*"/>  <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ============================================================== -->
            <!-- 1. COMPACT VERTICAL NAVBAR (Sidebar)                           -->
            <!-- ============================================================== -->
            <Border Grid.Column="0" Background="#080C14" CornerRadius="12,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/> <!-- App Icon / Brand -->
                        <RowDefinition Height="*"/>  <!-- Navigation Icon Buttons -->
                        <RowDefinition Height="40"/> <!-- Status Indicator -->
                    </Grid.RowDefinitions>

                    <!-- Top Brand Icon -->
                    <Border Grid.Row="0" Width="30" Height="30" Background="#00E5FF" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0B0F19"/>
                    </Border>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                        <Button Tag="0" Click="NavButton_Click" ToolTip="Dashboard" Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Tag="1" Click="NavButton_Click" ToolTip="Rotas Manuais" Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Tag="2" Click="NavButton_Click" ToolTip="Jogos" Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Tag="3" Click="NavButton_Click" ToolTip="Configurações" Width="38" Height="38" Margin="0,0,0,8" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Pin Status / Bottom Action -->
                    <Button Grid.Row="2" x:Name="BtnPin" Click="PinButton_Click" ToolTip="Fixar no Topo" Width="38" Height="38" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="📌" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" x:Name="TxtPin"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. MAIN CONTENT AREA                                           -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/> <!-- Top Header bar (Close/Minimize) -->
                    <RowDefinition Height="*"/>  <!-- Dynamic Tab Content -->
                    <RowDefinition Height="130"/> <!-- Real-Time Fibo Graph always visible! -->
                    <RowDefinition Height="46"/> <!-- Bottom Status Bar (Auto-Optimize toggle) -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="16,0" MouseDown="DragWindow">
                    <TextBlock Text="DASHBOARD DE REDE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="24" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Width="30" Height="24" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DYNAMIC CONTENT (Controlled by SelectedTabIndex) -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="16,0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/> <!-- Hides default tab headers -->
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- TAB 0: DASHBOARD -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Active Game Info Card -->
                            <Border Grid.Row="0" Background="#111827" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Width="40" Height="40" Background="#1E293B" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveGameName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ActiveGamePid}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Telemetry Comparison (Direct vs Optimized) -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Direct Route -->
                                <Border Grid.Column="0" Background="#111827" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ROTA PADRÃO" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#F97316">
                                            <Run Text="{Binding DirectPing, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=" ms" FontSize="12" Foreground="#64748B"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Jitter: " FontSize="10" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding DirectJitter, StringFormat={}{0:F1}ms}" FontSize="10" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Optimized Route -->
                                <Border Grid.Column="2" Background="#0C1220" CornerRadius="8" Padding="12" BorderBrush="#00E5FF" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00E5FF" Opacity="0.15"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="ACADEMY NOLAG" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#10B981">
                                            <Run Text="{Binding OptimizedPing, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=" ms" FontSize="12" Foreground="#64748B"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Melhoria: " FontSize="10" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding ImprovementDisplay}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Node Info -->
                            <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ROTA ATIVA (NODE)" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedNodeName}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF"/>
                                    <TextBlock Text="{Binding SelectedNodeRegion}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 1: ROTAS MANUAIS -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Selecione uma rota manualmente" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <!-- Rotas Disponíveis List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RelayNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                                        <TextBlock Text="{Binding Region}" Foreground="#64748B" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LatencyDisplay}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2" Content="APLICAR" Padding="10,4" Background="#1E293B" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#00E5FF" Command="{Binding DataContext.SelectManualRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: JOGOS -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Gerenciar Jogos" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GameProfiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111827" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#64748B" FontSize="10"/>
                                                    </StackPanel>
                                                    <!-- Toggle Per-Game Auto-Optimize -->
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoOptimize, Mode=TwoWay}" Content="Otimizar" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: CONFIGS -->
                    <TabItem>
                        <StackPanel>
                            <TextBlock Text="Ajustes de Rede e Sistema" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <Button Content="Limpar Cache DNS" Command="{Binding FlushDnsCommand}"
                                    Background="#1E293B" Foreground="#00E5FF" FontWeight="Bold" FontSize="12"
                                    Padding="12,10" BorderBrush="#00E5FF" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- REAL-TIME METRIC GRAPH (+150px section) -->
                <Border Grid.Row="2" Background="#080C14" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TELEMETRIA EM TEMPO REAL" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <controls:RealTimeMetricGraph Grid.Row="1" DirectPoints="{Binding DirectGraphPoints}" OptimizedPoints="{Binding OptimizedGraphPoints}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- BOTTOM STATUS BAR -->
                <Border Grid.Row="3" Background="#111827" CornerRadius="0,0,12,0" Padding="16,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Auto Optimize Toggle -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding AutoOptimize}" VerticalAlignment="Center" Cursor="Hand">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="18" CornerRadius="9" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#334155"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                            <Setter Property="Background" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Ellipse Width="14" Height="14" Fill="#F8FAFC" Margin="2,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Border>
                                        <TextBlock Text="Otimização Automática" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Status Badge -->
                        <Border Grid.Column="1" Background="#102E24" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
