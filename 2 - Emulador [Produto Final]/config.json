{
  "launcher": {
    "start_with_windows": false,
    "auto_start_servers_on_launch": true,
    "start_sequence_delay_seconds": 10,
    "clean_archived_logs_days": 7
  },
  "paths": {
    "base_dir": ".",
    "chat_server_dir": "ChatServer",
    "login_server_dir": "LoginServer",
    "game_server_dir": "GameServer",
    "chat_server_log_dir": "ChatServer/log",
    "login_server_log_dir": "LoginServer/log",
    "game_server_log_dir": "GameServer/log"
  },
  "gui": {
    "theme": "dark",
    "window_width": 1440,
    "window_height": 900,
    "http_port": 18080
  },
  "database": {
    "auto_read_properties": true,
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "88437295d*",
    "database": "aionclassic_gs"
  },
  "databases": {
    "gs": {
      "auto_read_properties": true,
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "88437295d*",
      "database": "aionclassic_gs",
      "properties_file": "GameServer/config/network/database.properties",
      "label": "Game Server",
      "color": "#32CD32"
    },
    "ls": {
      "auto_read_properties": true,
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "88437295d*",
      "database": "aionclassic_ls",
      "properties_file": "LoginServer/config/network/database.properties",
      "label": "Login Server",
      "color": "#FFD700"
    },
    "cs": {
      "auto_read_properties": true,
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "88437295d*",
      "database": "aionclassic_cs",
      "properties_file": "ChatServer/config/network/database.properties",
      "label": "Chat Server",
      "color": "#00CED1"
    }
  },
  "servers": {
    "chat": {
      "java_exe": "java",
      "jvm_args": ["-Xms72m","-Xmx72m","-XX:+UseNUMA","-XX:+UseCompactObjectHeaders","-Dfile.encoding=UTF-8","-DconsoleEncoding=UTF-8"],
      "main_class": "com.aionemu.chatserver.ChatServer",
      "classpath": "./libs/*",
      "working_dir": "ChatServer",
      "label": "Chat Server",
      "tag": "CS",
      "enabled": true,
      "color": "#00CED1",
      "management_port": null,
      "shutdown_delay_seconds": 10
    },
    "login": {
      "java_exe": "java",
      "jvm_args": ["-Xms48m","-Xmx48m","-XX:+UseNUMA","-XX:+UseCompactObjectHeaders","-Dfile.encoding=UTF-8","-DconsoleEncoding=UTF-8"],
      "main_class": "com.aionemu.loginserver.LoginServer",
      "classpath": "./libs/*",
      "working_dir": "LoginServer",
      "label": "Login Server",
      "tag": "LS",
      "enabled": true,
      "color": "#FFD700",
      "management_port": null,
      "shutdown_delay_seconds": 10
    },
    "game": {
      "java_exe": "java",
      "jvm_args": ["-Xms5G","-Xmx8G","-XX:+UseNUMA","-XX:+UseCompactObjectHeaders","-Dfile.encoding=UTF-8","-DconsoleEncoding=UTF-8"],
      "main_class": "com.aionemu.gameserver.GameServer",
      "classpath": "./libs/*",
      "working_dir": "GameServer",
      "label": "Game Server",
      "tag": "GS",
      "enabled": true,
      "color": "#32CD32",
      "management_port": null,
      "shutdown_delay_seconds": 10
    }
  }
}
