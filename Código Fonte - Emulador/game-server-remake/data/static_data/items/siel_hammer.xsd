<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <xs:complexType name="SielHammerReward">
  <xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
  <xs:attribute name="count" type="xs:positiveInteger" use="required"/>
  <xs:attribute name="probability" use="required"><xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="0"/><xs:maxInclusive value="1000"/></xs:restriction></xs:simpleType></xs:attribute>
 </xs:complexType>
 <xs:element name="siel_hammer"><xs:complexType><xs:sequence>
  <xs:element name="table" maxOccurs="unbounded"><xs:complexType><xs:sequence>
   <xs:element name="band" maxOccurs="3"><xs:complexType><xs:sequence>
    <xs:element name="result" type="SielHammerReward" maxOccurs="10"/>
    <xs:element name="bonus" type="SielHammerReward" minOccurs="0"/>
   </xs:sequence>
    <xs:attribute name="minimum" type="xs:unsignedByte" use="required"/>
    <xs:attribute name="maximum" type="xs:unsignedByte" use="required"/>
   </xs:complexType></xs:element>
  </xs:sequence><xs:attribute name="id" type="xs:positiveInteger" use="required"/><xs:attribute name="kinah" type="xs:nonNegativeInteger" use="required"/></xs:complexType></xs:element>
  <xs:element name="item" maxOccurs="unbounded"><xs:complexType><xs:attribute name="item_id" type="xs:positiveInteger" use="required"/><xs:attribute name="table_id" type="xs:positiveInteger" use="required"/></xs:complexType></xs:element>
 </xs:sequence></xs:complexType></xs:element>
</xs:schema>
