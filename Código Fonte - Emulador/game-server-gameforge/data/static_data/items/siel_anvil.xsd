<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:complexType name="SielAnvilIngredient">
		<xs:attribute name="item_id" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="count" type="xs:positiveInteger" use="required"/>
		<xs:attribute name="selected" type="xs:boolean" default="false"/>
	</xs:complexType>
	<xs:element name="siel_anvil_recipes">
		<xs:complexType><xs:sequence>
			<xs:element name="recipe" maxOccurs="unbounded">
				<xs:complexType><xs:sequence>
					<xs:element name="product" minOccurs="1" maxOccurs="2">
						<xs:complexType><xs:complexContent><xs:extension base="SielAnvilIngredient">
							<xs:attribute name="index" use="required"><xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="2"/></xs:restriction></xs:simpleType></xs:attribute>
							<xs:attribute name="probability" use="required"><xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="0"/><xs:maxInclusive value="10000"/></xs:restriction></xs:simpleType></xs:attribute>
						</xs:extension></xs:complexContent></xs:complexType>
					</xs:element>
					<xs:element name="refund" type="SielAnvilIngredient" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element name="materials" maxOccurs="unbounded">
						<xs:complexType><xs:sequence><xs:element name="item" type="SielAnvilIngredient" maxOccurs="19"/></xs:sequence></xs:complexType>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="id" type="xs:positiveInteger" use="required"/>
				<xs:attribute name="enabled" type="xs:boolean" use="required"/>
				<xs:attribute name="disabled_reason" type="xs:string"/>
				<xs:attribute name="ceiling_max_point" type="xs:unsignedShort"/>
				<xs:attribute name="failure_ceiling_point_min" type="xs:unsignedShort"/>
				<xs:attribute name="failure_ceiling_point_max" type="xs:unsignedShort"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence></xs:complexType>
	</xs:element>
</xs:schema>
