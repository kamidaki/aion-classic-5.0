<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!-- Moreth, Chronicle of Time (MOROS, Classic 5.0): níveis do client_moros_setting.xml e pontos por item do client_moros_point.xml.
		points = pontos para chegar ao nível (o contador zera a cada nível); rate = valor do ponto gravado nesse nível, em %; a passiva do
		nível é skill_id no skill_level. Cada category lista os itens que valem point por unidade. Gerado por parse_moros_50.py. -->
	<xs:simpleType name="MorosItemIds">
		<xs:list itemType="xs:positiveInteger"/>
	</xs:simpleType>
	<xs:element name="moros">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="level" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:attribute name="level" type="xs:positiveInteger" use="required"/>
						<xs:attribute name="points" type="xs:nonNegativeInteger" use="required"/>
						<xs:attribute name="rate" type="xs:positiveInteger" use="required"/>
						<xs:attribute name="skill_id" type="xs:positiveInteger" use="required"/>
						<xs:attribute name="skill_level" type="xs:positiveInteger" use="required"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="category" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="MorosItemIds">
								<xs:attribute name="name" type="xs:string" use="required"/>
								<xs:attribute name="point" type="xs:positiveInteger" use="required"/>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
