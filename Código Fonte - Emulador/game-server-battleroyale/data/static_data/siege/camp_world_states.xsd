<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0">
	<xs:include schemaLocation="../import.xsd"/>
	<!-- Estado de mapa que o oficial 5.0 manda ao entrar num mapa de camp war: variaveis de mundo (S_WORLD_VARIABLE,
	     0x180) e a lista inteira de zonas ligadas/desligadas (S_ZONE_STATE_LIST, 0x19D, um pacote por <camp_zone_packet>). -->
	<xs:element name="camp_world_states">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="import" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="camp_world" type="CampWorldStateType" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="CampWorldStateType">
		<xs:sequence>
			<xs:element name="camp_world_variable" type="CampWorldVariableType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="camp_zone_packet" type="CampZonePacketType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="world" type="xs:int" use="required"/>
	</xs:complexType>
	<xs:complexType name="CampWorldVariableType">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="value" type="xs:int" use="required"/>
	</xs:complexType>
	<xs:complexType name="CampZonePacketType">
		<xs:sequence>
			<xs:element name="camp_zone" type="CampZoneType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CampZoneType">
		<!-- com camp: o estado sai da torre (1 vulneravel, 0 protegida); sem camp: vale o state fixo da captura -->
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="camp" type="xs:int" default="0"/>
		<xs:attribute name="state" type="xs:int" default="0"/>
	</xs:complexType>
</xs:schema>
