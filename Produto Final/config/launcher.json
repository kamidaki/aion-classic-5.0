{
  "############################################################": "LOGIN-SERVER CONFIGURATION",
  "login-server": {
    "enabled": true,
    "bind_address": "127.0.0.1",
    "client_port": 2106,
    "hq_port": 13001,
    "sts_port": 6600,
    "announce_game_server_ip": "127.0.0.1",
    "announce_game_server_port": 7777,
    "default_server_id": 1,
    "auto_create_accounts": true,
    "development_mode": false,
    "default_dev_username": "",
    "security": {
      "enable_rate_limit": true,
      "max_attempts_per_minute": 15,
      "temp_ban_minutes": 10
    },
    "database": {
      "path": "login.db"
    }
  },
  "############################################################": "GAME-SERVER CONFIGURATION",
  "game-server": {
    "enabled": true,
    "bind_address": "127.0.0.1",
    "port": 7777,
    "server_id": 1,
    "server_name": "Brasil em Chamas (São Paulo)",
    "tick_rate_tps": 20,
    "max_players": 1000,
    "data_path": "data/client",
    "database": {
      "path": "game.db"
    }
  },
  "############################################################": "CHAT-SERVER CONFIGURATION",
  "chat-server": {
    "enabled": true,
    "bind_address": "127.0.0.1",
    "port": 10241,
    "max_channels": 500,
    "anti_flood_messages_per_sec": 5,
    "database": {
      "path": "chat.db"
    }
  },
  "############################################################": "LAUNCHER & SUPERVISOR CONFIGURATION",
  "launcher": {
    "autoStartLoginServer": true,
    "autoStartGameServer": true,
    "autoStartChatServer": true,
    "restartOnCrash": true,
    "crashRestartDelayMs": 5000,
    "gui": {
      "theme": "dark",
      "window_width": 1150,
      "window_height": 760,
      "http_port": 18080
    }
  },
  "############################################################": "LOGGING & RETENTION (10 DAYS MAX)",
  "logging": {
    "retentionDays": 10,
    "loginServerPath": "logs/login-server",
    "gameServerPath": "logs/game-server",
    "chatServerPath": "logs/chat-server"
  }
}