<Window x:Class="AcademyNoLag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AcademyNoLag.App.Controls"
        xmlns:vm="clr-namespace:AcademyNoLag.App.ViewModels"
        mc:Ignorable="d"
        Title="Academy NoLag — Game Network Routing Optimizer" 
        Height="780" Width="1200"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/> <!-- Header -->
            <RowDefinition Height="*"/>  <!-- Main Body -->
            <RowDefinition Height="36"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00E5FF" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0B0F19"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACADEMY " FontWeight="Black" FontSize="18" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="NOLAG" FontWeight="Black" FontSize="18" Foreground="{StaticResource AccentCyan}"/>
                        </StackPanel>
                        <TextBlock Text="Enterprise Game Network Routing Optimizer" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBright}" BorderThickness="1" CornerRadius="20" Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOptimized}" Value="False">
                                                <Setter Property="Fill" Value="#F59E0B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SimulateAionLaunchCommand}" Margin="0,0,10,0" ToolTip="Test detection with simulated Aion Classic client">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮 Simulate Aion 5.0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleOptimizationCommand}">
                        <TextBlock Text="TOGGLE OPTIMIZATION"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Sidebar Navigation -->
                <ColumnDefinition Width="*"/>   <!-- Content Area -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="0" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="⚡  Dashboard" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="1" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="🌐  Route Explorer" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="2" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="🖥️  Relay Nodes" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="3" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="🎮  Game Profiles" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="4" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="📊  Benchmark" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="5" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="🛠️  Diagnostics &amp; Logs" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource GamingButton}" Command="{Binding SelectTabCommand}" CommandParameter="6" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                        <TextBlock Text="⚙️  Settings" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- CONTENT VIEWS (Indexed by SelectedTabIndex) -->
            <Grid Grid.Column="1" Margin="20">

                <!-- VIEW 0: DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <!-- Active Game Card -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#1E293B" Width="48" Height="48" CornerRadius="8" Margin="0,0,16,0">
                                    <TextBlock Text="⚔️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActiveGameName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0"/>
                                        <Border Background="{StaticResource BorderDark}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveGamePid}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveGameExe}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Optimization Node" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedNodeName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedNodeRegion}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Telemetry KPI Cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PING CARD -->
                            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ROUND-TRIP LATENCY (RTT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding OptimizedPing, StringFormat={}{0:F0}}" FontSize="32" FontWeight="Black" Foreground="{StaticResource AccentCyan}"/>
                                        <TextBlock Text=" ms" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Default: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding DirectPing, StringFormat={}{0:F0} ms}" FontSize="11" Foreground="{StaticResource AccentOrange}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ImprovementDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- JITTER CARD -->
                            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="JITTER (RFC 3550)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding OptimizedJitter, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Black" Foreground="{StaticResource AccentCyan}"/>
                                        <TextBlock Text=" ms" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Baseline: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding DirectJitter, StringFormat={}{0:F1} ms}" FontSize="11" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- PACKET LOSS CARD -->
                            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="PACKET LOSS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding OptimizedLoss, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Black" Foreground="{StaticResource AccentEmerald}"/>
                                        <TextBlock Text=" %" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Baseline: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding DirectLoss, StringFormat={}{0:F1}%}" FontSize="11" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ROUTE QUALITY CARD -->
                            <Border Grid.Column="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ROUTE QUALITY SCORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="{Binding RouteQualityScore, StringFormat={}{0:F0}}" FontSize="32" FontWeight="Black" Foreground="{StaticResource AccentCyan}"/>
                                        <TextBlock Text=" / 100" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Grade: " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding RouteGrade}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmerald}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ExitLag Technology Ribbon -->
                        <Border Background="#101827" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="⚡ TECNOLOGIAS ATIVAS (EXITLAG ENGINE):" FontSize="11" FontWeight="Black" Foreground="{StaticResource AccentCyan}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="#15262F" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ MULTIPATH (2 ROTAS ATIVAS)" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                    <Border Background="#102E24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ TCP IMMEDIATE ACK (1)" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                    <Border Background="#102E24" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ TCP_NODELAY (SEM BUFFER)" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ DSCP 46 (QOS EXPEDITED)" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </Border>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ PROCESSO ALTA PRIORIDADE" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </Border>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,8,2">
                                        <TextBlock Text="✓ HOST ROUTE /32 (METRIC 1)" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Real-time Vector Graph -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="REAL-TIME TELEMETRY (DEFAULT VS OPTIMIZED ROUTE)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                <controls:RealTimeMetricGraph Height="220" DirectPoints="{Binding DirectGraphPoints}" OptimizedPoints="{Binding OptimizedGraphPoints}"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Active Sockets Table -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ACTIVE GAME NETWORK ENDPOINTS (DYNAMIC DISCOVERY)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding ActiveEndpoints}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#151E32"
                                          Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                                        <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" Width="160"/>
                                        <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePort}" Width="100"/>
                                        <DataGridTextColumn Header="Local Endpoint" Binding="{Binding LocalEndPoint}" Width="180"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 1: ROUTE EXPLORER -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ROUTE HOP DISCOVERY &amp; PEERING BOTTLENECK ANALYSIS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Traces intermediate hops using ICMP TTL stepping to detect ISP transit and peering latency." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding TraceRouteCommand}" Content="Trace Route to Server"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <DataGrid ItemsSource="{Binding DiscoveredHops}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="Transparent" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#151E32"
                                      Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hop" Binding="{Binding HopIndex}" Width="60"/>
                                    <DataGridTextColumn Header="IP Address" Binding="{Binding DisplayAddress}" Width="180"/>
                                    <DataGridTextColumn Header="Hostname / Node" Binding="{Binding HostName}" Width="*"/>
                                    <DataGridTextColumn Header="RTT (ms)" Binding="{Binding RttMs, StringFormat={}{0:F1}}" Width="100"/>
                                    <DataGridTextColumn Header="Loss (%)" Binding="{Binding PacketLossPercentage, StringFormat={}{0:F0}%}" Width="90"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 2: RELAY NODES -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="OPTIMIZATION RELAY NETWORK (EDGE GATEWAYS)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Select a relay node to route game packets through an optimized peering path." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GamingButton}" Command="{Binding RefreshNodesCommand}" Content="🔄 Refresh Latencies"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <DataGrid ItemsSource="{Binding RelayNodes}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="Transparent" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#151E32"
                                      Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Node Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Region" Binding="{Binding LocationDisplay}" Width="160"/>
                                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140"/>
                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                                    <DataGridTextColumn Header="Ping" Binding="{Binding LatencyDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 3: GAME PROFILES -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SUPPORTED GAME PROFILES &amp; DETECTION RULES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Add custom online games, private servers, or manage built-in profile rules." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding AddCustomProfileCommand}" Content="➕ Add Custom Game (.exe)"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding GameProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1E293B" Width="40" Height="40" CornerRadius="6" Margin="0,0,14,0">
                                                <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource BorderDark}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 4: BENCHMARK -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="NETWORK BENCHMARK RUNNER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Conducts 50 probe samples to calculate statistical percentiles (Mean, Median, P95, P99, Jitter, Packet Loss, StdDev)." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BenchmarkTargetIp, UpdateSourceTrigger=PropertyChanged}" Background="#1E293B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" Padding="10,8" FontSize="13" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RunBenchmarkCommand}" Content="Run Benchmark (50 Packets)"/>
                                </Grid>
                                <ProgressBar Value="{Binding BenchmarkProgress}" Maximum="100" Height="6" Margin="0,14,0,0" Foreground="{StaticResource AccentCyan}" Background="#1E293B" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="BENCHMARK RESULTS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding BenchmarkResultsSummary}" IsReadOnly="True" Background="#0F172A" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" Padding="12" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="140"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 5: DIAGNOSTICS & LOGS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <!-- Network Interfaces -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SYSTEM NETWORK INTERFACES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding NetworkInterfaces}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          Background="Transparent" BorderThickness="0" RowBackground="#111827" AlternatingRowBackground="#151E32"
                                          Foreground="{StaticResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Interface Name" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding InterfaceType}" Width="100"/>
                                        <DataGridTextColumn Header="IPv4" Binding="{Binding PrimaryIpDisplay}" Width="130"/>
                                        <DataGridTextColumn Header="Gateway" Binding="{Binding GatewayIPv4}" Width="130"/>
                                        <DataGridTextColumn Header="Speed" Binding="{Binding DisplaySpeed}" Width="100"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding OperationalStatus}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Live Console Logs -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="LIVE TELEMETRY &amp; DIAGNOSTIC LOGS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding LiveLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Formatted}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW 6: SETTINGS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ROUTING &amp; HYSTERESIS PREFERENCES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
                                <CheckBox IsChecked="{Binding AutoOptimize}" Content="Automatically optimize supported games upon detection" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                <TextBlock Text="Hysteresis Sensitivity: Route switch requires minimum 7.0% improvement and 4.0 ms reduction." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                                <TextBlock Text="Failsafe: Automatic fallback restores normal Windows default routing if latency spikes or packet loss exceeds direct route." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                                <TextBlock Text="Zero-Fake Guarantee: Real RTT measurements only. No artificially simulated ping drops." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentEmerald}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Academy NoLag Engine v1.0 • .NET 9 Native" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ActiveGameName, StringFormat=Active: {0}}" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Failsafe Guard: ACTIVE" FontSize="11" Foreground="{StaticResource AccentEmerald}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
